# =============================================================================
# Planvio - public document root
#
# Point your domain's document root at this directory.
# Works with Apache 2.4 and LiteSpeed / OpenLiteSpeed.
# =============================================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Pass the Authorization header through to PHP (API tokens depend on it and
    # CGI/FastCGI strips it by default).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Block dotfiles outright, including anything uploaded into a sub-path.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Redirect trailing slashes if not a folder.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Front controller.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# -----------------------------------------------------------------------------
# The storage symlink carries avatars and workspace logos only. Task and comment
# attachments are NEVER placed here - they are streamed by an authorising
# controller from storage/app/private. Refuse to execute anything found here.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^storage/.*\.(php|phtml|phar|php[3-8]|inc|pl|py|cgi|sh|htaccess)$ - [F,L,NC]
</IfModule>

<Directory "storage">
    <IfModule mod_php.c>
        php_flag engine off
    </IfModule>
    <IfModule lsapi_module>
        RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
    </IfModule>
    Options -ExecCGI
</Directory>

# -----------------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

    # Enable once HTTPS is confirmed working on every hostname you serve.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Long-lived immutable caching for fingerprinted build output.
    <FilesMatch "\.(css|js|woff2|woff|ttf|svg|png|jpg|jpeg|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

ServerSignature Off

# Never serve source or config files that might land here by accident.
<FilesMatch "\.(env|log|sqlite|sqlite3|db|sql|bak|swp|dist|lock|neon|yml|yaml|md|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# manifest.json is emitted by Vite into build/ and must stay readable.
<Files "manifest.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>
