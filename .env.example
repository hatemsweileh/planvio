###############################################################################
# Planvio
#
# You normally do NOT edit this file by hand. Upload Planvio, open your domain
# in a browser and the installation wizard writes .env for you.
#
# This file documents every supported key for administrators who prefer to
# configure Planvio manually or who are automating a deployment.
###############################################################################

APP_NAME=Planvio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

# Written by the installer once installation completes. Do not set by hand.
APP_INSTALLED=false

APP_MAINTENANCE_DRIVER=file

# --- Branding ---------------------------------------------------------------
APP_LOGO=/img/brand/planvio-logo-h.svg
APP_FAVICON=/favicon.svg
APP_PRIMARY_COLOR=#3F66B0
APP_SUPPORT_URL=

# --- Database ---------------------------------------------------------------
# On cPanel the database name and user are normally prefixed with your account
# name, for example: acme_planvio and acme_planvio_user.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=planvio
DB_USERNAME=
DB_PASSWORD=

# --- Session, cache, queue --------------------------------------------------
# All database backed on purpose: Planvio requires no Redis and no daemon.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# How long before an unfinished job is considered stalled and handed to another
# worker. This MUST stay above the longest a single job can run, or a long AI agent
# run will be executed twice. Planvio derives a safe floor from AI_MAX_RUN_SECONDS,
# so you only need to set this if you run other long jobs of your own.
# DB_QUEUE_RETRY_AFTER=600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# --- Mail -------------------------------------------------------------------
# Standard SMTP. No transactional email provider is required.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=planvio@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Planvio behaviour ------------------------------------------------------
PLANVIO_MAX_UPLOAD_KB=20480
PLANVIO_CURRENCY=USD
PLANVIO_DATE_FORMAT=Y-m-d
PLANVIO_PASSWORD_MIN=10
PLANVIO_CHECK_PWNED=false
PLANVIO_2FA_REQUIRED_ADMINS=false
# 0 disables the idle timeout.
PLANVIO_IDLE_TIMEOUT=0
# 0 keeps activity history forever.
PLANVIO_ACTIVITY_RETENTION_DAYS=0
PLANVIO_AUDIT_RETENTION_DAYS=730

# --- Content-Security-Policy ------------------------------------------------
# Sent on every page, the /admin panel included. It limits the blast radius of
# an XSS bug; it does not prevent one — the shipped policy keeps 'unsafe-inline'
# and 'unsafe-eval' because Alpine evaluates its expressions at runtime. Tighten
# it in config/planvio.php -> security.csp.extra_directives once you have audited
# your install, and try the change with report-only first. See docs/SECURITY.md
# section 5.1.
PLANVIO_CSP=true
PLANVIO_CSP_REPORT_ONLY=false

# The same two switches for the administration panel, which assembles its own
# middleware stack. Leave them unset — as below — and /admin follows the two
# above. Set one to move the panel on its own, for example to enforce the policy
# on the product while trying it in report-only on /admin.
# PLANVIO_ADMIN_CSP=true
# PLANVIO_ADMIN_CSP_REPORT_ONLY=false

# --- Rate limits (requests per minute) --------------------------------------
# Generous on purpose: these stop a stuck poller or a scripted loop, they are
# not meant to pace real use. Page requests are keyed on the signed-in account,
# so an office behind one address is not one bucket. The reasoning behind each
# number is in config/planvio.php -> security.rate_limits.
PLANVIO_RATE_WEB=300
PLANVIO_RATE_GUEST=120
PLANVIO_RATE_SEARCH=60
PLANVIO_RATE_AI_RUNS=10
PLANVIO_RATE_EXPORTS=10
PLANVIO_RATE_REPORTS=20

# --- Upload scanning --------------------------------------------------------
# Planvio ships no virus scanner. Leave this empty unless your server already
# runs ClamAV; set it to "clamav" to have every upload streamed to clamd before
# it is stored. A scanner that is configured and cannot be reached REFUSES the
# upload rather than accepting it, so a wrong socket path stops uploads working.
# Prefer the unix socket when clamd is on the same host: it wins over host/port.
PLANVIO_UPLOAD_SCANNER=
PLANVIO_CLAMAV_SOCKET=
PLANVIO_CLAMAV_HOST=127.0.0.1
PLANVIO_CLAMAV_PORT=3310
PLANVIO_CLAMAV_TIMEOUT=30
# Must match clamd.conf StreamMaxLength. A larger file is refused unscanned.
PLANVIO_CLAMAV_MAX_BYTES=26214400

# --- AI ---------------------------------------------------------------------
# Master switch. When false, no AI route, job or provider call runs at all and
# the rest of Planvio is unaffected. Provider credentials are stored encrypted
# in the database (Settings -> AI), never in this file.
AI_ENABLED=false
AI_AUTOMATIONS_ENABLED=true
AI_MAX_TOOL_CALLS=25
AI_MAX_RUN_SECONDS=180
AI_MAX_CONTEXT_TOKENS=24000
AI_MAX_RUNS_PER_HOUR=60
AI_TIMEOUT=60
AI_QUEUE_CONNECTION=database
AI_QUEUE=ai
# Leave false in production: prompt bodies can contain workspace content.
AI_STORE_PROMPTS=false

# --- Vite (development only) ------------------------------------------------
# Production serves the compiled assets in public/build and never needs Node.
VITE_APP_NAME="${APP_NAME}"
