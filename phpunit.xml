<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Security</exclude>
            <exclude>tests/Feature/Installer</exclude>
        </testsuite>
        <!--
            Isolation, authorization and AI-permission tests. Kept as its own suite so it
            can be run alone in CI and so a failure here is unmistakable: every test in it
            asserts that something is NOT possible.
        -->
        <testsuite name="Security">
            <directory>tests/Feature/Security</directory>
        </testsuite>
        <!--
            Installer tests manipulate the install lock and .env, so they run last and
            never interleave with the rest.
        -->
        <testsuite name="Installer">
            <directory>tests/Feature/Installer</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Providers/Filament</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:5RQ2vI0kM9jK7YbN3cXwFqPzT1aH8sLdEoUvRgWnJxY="/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_INSTALLED" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!--
            AI is enabled in tests so the tool registry, policy engine and agent loop are
            exercised, but no provider is configured: every test that reaches the network
            must use a faked HTTP client. A real outbound call in the suite is a bug.
        -->
        <env name="AI_ENABLED" value="true"/>
        <env name="AI_AUTOMATIONS_ENABLED" value="false"/>
        <env name="AI_STORE_PROMPTS" value="false"/>
    </php>
</phpunit>
